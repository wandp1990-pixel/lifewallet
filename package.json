{
  "name": "lifewallet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:fresh": "rm -rf .next && next dev",
    "prebuild": "node scripts/check-assets.mjs",
    "build": "node scripts/check-assets.mjs && next build",
    "start": "next start",
    "test": "node --import tsx scripts/report_spec_check.ts",
    "test:mcp": "node --import tsx scripts/work_mcp_check.ts && node --import tsx scripts/ledger_mcp_check.ts && node --import tsx scripts/work_oauth_check.ts && node --import tsx scripts/asset_delete_check.ts",
    "test:mcp:http": "node --import tsx scripts/http_mcp_check.ts"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.7",
    "@better-auth/mcp": "1.7.7",
    "@better-auth/oauth-provider": "1.7.7",
    "@google/generative-ai": "^0.24.1",
    "@libsql/client": "^0.17.3",
    "@libsql/kysely-libsql": "0.4.1",
    "better-auth": "1.7.7",
    "kysely": "0.28.8",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "swr": "^2.4.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5",
    "tsx": "4.21.0",
    "vercel": "^54.4.1"
  }
}
